{
  "name": "simple-block-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A very small multiplayer 3D block sandbox (TypeScript, Three.js, Node.js, WebSockets, Vite)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "three": "^0.160.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
